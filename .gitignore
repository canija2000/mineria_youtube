# secretos
.env

# entorno
.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store
*.pdf 

# datos: se ignora todo data/ (se regenera con recolect.py) salvo la tabla de métricas
data/*
!data/metricas.csv

# informe LaTeX: solo el .tex, el .pdf y las figuras; el resto son auxiliares de pdflatex/latexmk
informe/*
!informe/*.tex
!informe/main.pdf
!informe/figs/
*.pptx
*.mp4

# entregas (presentaciones, videos, pauta): fuera del control de versiones
entregas/
